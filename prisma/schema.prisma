// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tower {
  tower_id       String       @id @default(cuid())
  clerk_id       String       @unique
  email          String       @unique
  full_name      String
  payments_alias String?
  vehicles       Vehicle[]
  assignments    Assignment[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deactivated    Boolean      @default(false)
}

model Admin {
  admin_id   String   @id @default(cuid())
  clerk_id   String   @unique
  email      String   @unique
  full_name  String

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deactivated    Boolean  @default(false)
}

model Vehicle {
  vehicle_id String @id @default(uuid())
  brand      String
  model      String
  year       Int
  max_load   Float
  tower_id   String
  tower      Tower  @relation(fields: [tower_id], references: [tower_id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deactivated    Boolean  @default(false)
}

model Assignment {
  assignment_id String   @id @default(uuid())
  trip_id       String   @unique // trip_id ahora es único
  tower_id      String
  tower         Tower    @relation(fields: [tower_id], references: [tower_id], onDelete: Cascade)
  status        String   // pending, accepted, completed, cancelled
  location      Json     // {lat: string, long: string}

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deactivated    Boolean  @default(false)
}
